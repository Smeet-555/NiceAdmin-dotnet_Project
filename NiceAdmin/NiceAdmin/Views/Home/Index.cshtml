@model NiceAdmin.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="pagetitle">
    <h1>Dashboard</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section dashboard">
    <div class="row">

        <!-- Left side columns -->
        <div class="col-lg-8">
            <div class="row">

                <!-- Total Meetings Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card sales-card">
                        <div class="card-body">
                            <h5 class="card-title">Total Meetings <span>| Today</span></h5>

                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-calendar-event"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@Model.TodayMeetings</h6>
                                    @if (Model.TodayCompletedMeetings > 0)
                                    {
                                        <span class="text-success small pt-1 fw-bold">@Model.TodayCompletedMeetings</span> 
                                        <span class="text-muted small pt-2 ps-1">completed</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small pt-2 ps-1">No meetings yet</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Total Meetings Card -->

                <!-- Active Staff Card -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card revenue-card">
                        <div class="card-body">
                            <h5 class="card-title">Total Staff <span>| Active</span></h5>

                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-people"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@Model.TotalStaff</h6>
                                    @if (Model.ThisMonthStaffAdded > 0)
                                    {
                                        <span class="text-success small pt-1 fw-bold">@Model.ThisMonthStaffAdded</span> 
                                        <span class="text-muted small pt-2 ps-1">new this month</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small pt-2 ps-1">No new staff</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Active Staff Card -->

                <!-- Departments Card -->
                <div class="col-xxl-4 col-xl-12">
                    <div class="card info-card customers-card">
                        <div class="card-body">
                            <h5 class="card-title">Departments <span>| Total</span></h5>

                            <div class="d-flex align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-building"></i>
                                </div>
                                <div class="ps-3">
                                    <h6>@Model.TotalDepartments</h6>
                                    @if (Model.ThisMonthDepartmentsAdded > 0)
                                    {
                                        <span class="text-success small pt-1 fw-bold">@Model.ThisMonthDepartmentsAdded</span> 
                                        <span class="text-muted small pt-2 ps-1">new this month</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small pt-2 ps-1">No new departments</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!-- End Departments Card -->

                <!-- Meeting Analytics -->
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Meeting Analytics <span>/Last 7 Days</span></h5>

                            <!-- Line Chart -->
                            <div id="reportsChart"></div>

                            <script>
                                document.addEventListener("DOMContentLoaded", () => {
                                  // Get data from server
                                  var weeklyData = @Html.Raw(Json.Serialize(Model.WeeklyMeetingData));
                                  
                                  var categories = weeklyData.map(d => d.date);
                                  var values = weeklyData.map(d => d.value);
                                  
                                  new ApexCharts(document.querySelector("#reportsChart"), {
                                    series: [{
                                      name: 'Meetings',
                                      data: values.length > 0 ? values : [0, 0, 0, 0, 0, 0, 0]
                                    }],
                                    chart: {
                                      height: 350,
                                      type: 'area',
                                      toolbar: {
                                        show: false
                                      },
                                    },
                                    markers: {
                                      size: 4
                                    },
                                    colors: ['#4154f1'],
                                    fill: {
                                      type: "gradient",
                                      gradient: {
                                        shadeIntensity: 1,
                                        opacityFrom: 0.3,
                                        opacityTo: 0.4,
                                        stops: [0, 90, 100]
                                      }
                                    },
                                    dataLabels: {
                                      enabled: false
                                    },
                                    stroke: {
                                      curve: 'smooth',
                                      width: 2
                                    },
                                    xaxis: {
                                      type: 'datetime',
                                      categories: categories.length > 0 ? categories : ["2024-01-15T00:00:00.000Z", "2024-01-16T00:00:00.000Z", "2024-01-17T00:00:00.000Z", "2024-01-18T00:00:00.000Z", "2024-01-19T00:00:00.000Z", "2024-01-20T00:00:00.000Z", "2024-01-21T00:00:00.000Z"]
                                    },
                                    tooltip: {
                                      x: {
                                        format: 'dd/MM/yy'
                                      },
                                    }
                                  }).render();
                                });
                            </script>
                            <!-- End Line Chart -->
                        </div>
                    </div>
                </div><!-- End Meeting Analytics -->

                <!-- Recent Meetings -->
                <div class="col-12">
                    <div class="card recent-sales overflow-auto">
                        <div class="card-body">
                            <h5 class="card-title">Recent Meetings <span>| Latest</span></h5>

                            @if (Model.RecentMeetings.Any())
                            {
                                <table class="table table-borderless datatable">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Date</th>
                                            <th scope="col">Type</th>
                                            <th scope="col">Department</th>
                                            <th scope="col">Venue</th>
                                            <th scope="col">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var meeting in Model.RecentMeetings)
                                        {
                                            <tr>
                                                <th scope="row"><a href="#">#M@meeting.MeetingId.ToString("000")</a></th>
                                                <td>@meeting.MeetingDate.ToString("MMM dd, yyyy")</td>
                                                <td>@meeting.MeetingTypeName</td>
                                                <td>@meeting.DepartmentName</td>
                                                <td>@meeting.MeetingVenueName</td>
                                                <td>
                                                    @if (meeting.IsCancelled)
                                                    {
                                                        <span class="badge bg-danger">Cancelled</span>
                                                    }
                                                    else if (meeting.MeetingDate < DateTime.Now)
                                                    {
                                                        <span class="badge bg-success">Completed</span>
                                                    }
                                                    else if (meeting.MeetingDate.Date == DateTime.Today)
                                                    {
                                                        <span class="badge bg-warning">Today</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary">Scheduled</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="text-muted">No recent meetings found.</p>
                            }
                        </div>
                    </div>
                </div><!-- End Recent Meetings -->

                <!-- Meeting Types Overview -->
                <div class="col-12">
                    <div class="card top-selling overflow-auto">
                        <div class="card-body pb-0">
                            <h5 class="card-title">Popular Meeting Types <span>| Overview</span></h5>

                            @if (Model.MeetingTypeStats.Any())
                            {
                                <table class="table table-borderless">
                                    <thead>
                                        <tr>
                                            <th scope="col">Type</th>
                                            <th scope="col">Count</th>
                                            <th scope="col">Avg Duration</th>
                                            <th scope="col">Success Rate</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var type in Model.MeetingTypeStats)
                                        {
                                            <tr>
                                                <td><i class="bi bi-calendar-check text-primary me-2"></i>@type.MeetingTypeName</td>
                                                <td class="fw-bold">@type.Count</td>
                                                <td>@type.AverageDuration</td>
                                                <td>
                                                    @if (type.SuccessRate >= 90)
                                                    {
                                                        <span class="text-success">@type.SuccessRate.ToString("F0")%</span>
                                                    }
                                                    else if (type.SuccessRate >= 75)
                                                    {
                                                        <span class="text-warning">@type.SuccessRate.ToString("F0")%</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">@type.SuccessRate.ToString("F0")%</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="text-muted">No meeting type statistics available.</p>
                            }
                        </div>
                    </div>
                </div><!-- End Meeting Types Overview -->

            </div>
        </div><!-- End Left side columns -->

        <!-- Right side columns -->
        <div class="col-lg-4">

            <!-- Recent Activity -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Recent Activity <span>| Latest</span></h5>

                    @if (Model.RecentActivities.Any())
                    {
                        <div class="activity">
                            @foreach (var activity in Model.RecentActivities)
                            {
                                <div class="activity-item d-flex">
                                    <div class="activite-label">@activity.TimeAgo</div>
                                    <i class='bi bi-circle-fill activity-badge text-@activity.Type align-self-start'></i>
                                    <div class="activity-content">
                                        @Html.Raw(activity.Activity)
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No recent activities.</p>
                    }
                </div>
            </div><!-- End Recent Activity -->

            <!-- Department Overview -->
            <div class="card">
                <div class="card-body pb-0">
                    <h5 class="card-title">Department Activity <span>| Overview</span></h5>

                    <div id="departmentChart" style="min-height: 400px;" class="echart"></div>

                    <script>
                        document.addEventListener("DOMContentLoaded", () => {
                          // Get data from server
                          var departmentData = @Html.Raw(Json.Serialize(Model.DepartmentStats));
                          
                          var departmentNames = departmentData.map(d => d.departmentName);
                          var meetingCounts = departmentData.map(d => d.meetingCount);
                          var staffCounts = departmentData.map(d => d.staffCount);
                          
                          // Calculate max values for radar chart
                          var maxMeetings = Math.max(...meetingCounts, 10);
                          var maxStaff = Math.max(...staffCounts, 10);
                          
                          var indicators = departmentNames.map(name => ({
                            name: name,
                            max: Math.max(maxMeetings, maxStaff)
                          }));
                          
                          if (departmentData.length > 0) {
                            echarts.init(document.querySelector("#departmentChart")).setOption({
                              legend: {
                                data: ['Meetings Held', 'Staff Count']
                              },
                              radar: {
                                indicator: indicators
                              },
                              series: [{
                                name: 'Department Activity',
                                type: 'radar',
                                data: [{
                                    value: meetingCounts,
                                    name: 'Meetings Held'
                                  },
                                  {
                                    value: staffCounts,
                                    name: 'Staff Count'
                                  }
                                ]
                              }]
                            });
                          } else {
                            document.querySelector("#departmentChart").innerHTML = '<p class="text-muted text-center mt-5">No department data available</p>';
                          }
                        });
                    </script>
                </div>
            </div><!-- End Department Overview -->

            <!-- Meeting Status Distribution -->
            <div class="card">
                <div class="card-body pb-0">
                    <h5 class="card-title">Meeting Status <span>| Overview</span></h5>

                    <div id="statusChart" style="min-height: 400px;" class="echart"></div>

                    <script>
                        document.addEventListener("DOMContentLoaded", () => {
                          var totalMeetings = @Model.TotalMeetings;
                          var todayMeetings = @Model.TodayMeetings;
                          var completedMeetings = @Model.TodayCompletedMeetings;
                          var scheduledMeetings = @Model.TodayScheduledMeetings;
                          var cancelledMeetings = @Model.TodayCancelledMeetings;
                          
                          // Calculate approximate values for the pie chart
                          var completed = Math.max(completedMeetings, Math.floor(totalMeetings * 0.6));
                          var scheduled = Math.max(scheduledMeetings, Math.floor(totalMeetings * 0.3));
                          var cancelled = Math.max(cancelledMeetings, Math.floor(totalMeetings * 0.1));
                          
                          if (totalMeetings > 0) {
                            echarts.init(document.querySelector("#statusChart")).setOption({
                              tooltip: {
                                trigger: 'item'
                              },
                              legend: {
                                top: '5%',
                                left: 'center'
                              },
                              series: [{
                                name: 'Meeting Status',
                                type: 'pie',
                                radius: ['40%', '70%'],
                                avoidLabelOverlap: false,
                                label: {
                                  show: false,
                                  position: 'center'
                                },
                                emphasis: {
                                  label: {
                                    show: true,
                                    fontSize: '18',
                                    fontWeight: 'bold'
                                  }
                                },
                                labelLine: {
                                  show: false
                                },
                                data: [{
                                    value: completed,
                                    name: 'Completed'
                                  },
                                  {
                                    value: scheduled,
                                    name: 'Scheduled'
                                  },
                                  {
                                    value: cancelled,
                                    name: 'Cancelled'
                                  }
                                ]
                              }]
                            });
                          } else {
                            document.querySelector("#statusChart").innerHTML = '<p class="text-muted text-center mt-5">No meeting data available</p>';
                          }
                        });
                    </script>
                </div>
            </div><!-- End Meeting Status Distribution -->

            <!-- Quick Actions -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Quick Actions</h5>
                    
                    <div class="d-grid gap-2">
                        <a asp-controller="Meeting" asp-action="MeetingAddEdit" class="btn btn-primary">
                            <i class="bi bi-plus-lg me-2"></i>Schedule New Meeting
                        </a>
                        <a asp-controller="Staff" asp-action="StaffAddEdit" class="btn btn-outline-primary">
                            <i class="bi bi-person-plus me-2"></i>Add Staff Member
                        </a>
                        <a asp-controller="Department" asp-action="DepartmentAddEdit" class="btn btn-outline-secondary">
                            <i class="bi bi-building me-2"></i>Create Department
                        </a>
                        <a asp-controller="MeetingVenue" asp-action="MeetingVenueAddEdit" class="btn btn-outline-info">
                            <i class="bi bi-geo-alt me-2"></i>Add Meeting Venue
                        </a>
                    </div>
                </div>
            </div><!-- End Quick Actions -->

        </div><!-- End Right side columns -->

    </div>
</section>
